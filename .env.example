# Porta pública única do gateway.
PORT=8080
HOST=0.0.0.0

# Porta publicada pelo Docker Compose no host.
PUBLIC_PORT=8080

# Portas privadas dos dois módulos. Devem ser diferentes de PORT.
CLIENTES_INTERNAL_PORT=3000
FUNCIONARIOS_INTERNAL_PORT=3001

# Links entre os módulos quando servidos pelo gateway.
CLIENTES_URL=/
FUNCIONARIOS_URL=/funcionarios/

NODE_ENV=production
PROXY_TIMEOUT_MS=30000
STARTUP_TIMEOUT_MS=20000
HEALTH_TIMEOUT_MS=3000
